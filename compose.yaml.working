services:

  supabase-db:
    image: supabase/postgres:15.1.1.23
    container_name: supabase-db

    environment:
      POSTGRES_DB: postgres
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres

    ports:
      - "5432:5432"

    volumes:
      - supabase_db_data:/var/lib/postgresql/data

    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres", "-d", "postgres"]
      interval: 5s
      timeout: 5s
      retries: 5

  supabase-meta:
    image: supabase/postgres-meta:v0.84.2
    container_name: supabase-meta

    depends_on:
      supabase-db:
        condition: service_healthy

    environment:
      PG_META_PORT: 8080
      PG_META_DB_HOST: supabase-db
      PG_META_DB_NAME: postgres
      PG_META_DB_USER: postgres
      PG_META_DB_PASSWORD: postgres
      PG_META_DB_PORT: 5432

    ports:
      - "8085:8080"

  supabase-auth:
    image: supabase/gotrue:v2.132.2
    container_name: supabase-auth

    depends_on:
      supabase-db:
        condition: service_healthy

    environment:

      GOTRUE_API_HOST: 0.0.0.0
      GOTRUE_API_PORT: 9999
      GOTRUE_API_EXTERNAL_URL: https://refactored-pancake-6vvx77g55965h5q4j-9999.app.github.dev
      API_EXTERNAL_URL: https://refactored-pancake-6vvx77g55965h5q4j-9999.app.github.dev
      GOTRUE_CORS_ALLOWED_ORIGINS: https://cuddly-goggles-v6xrgrv5rvx9hwrrj-3000.app.github.dev
      GOTRUE_DB_DRIVER: postgres
      GOTRUE_DB_DATABASE_URL: postgres://postgres:postgres@supabase-db:5432/postgres?sslmode=disable&options=-csearch_path%3Dauth,public
      GOTRUE_DB_SEARCH_PATH: auth,public
      GOTRUE_DB_AUTOMIGRATE: "true"
      GOTRUE_JWT_SECRET: ${JWT_SECRET}
      GOTRUE_JWT_EXP: 3600
      GOTRUE_SITE_URL: https://cuddly-goggles-v6xrgrv5rvx9hwrrj-3000.app.github.dev

      GOTRUE_URI_ALLOW_LIST: https://cuddly-goggles-v6xrgrv5rvx9hwrrj-3000.app.github.dev
      GOTRUE_DISABLE_SIGNUPS: "false"
      GOTRUE_EXTERNAL_EMAIL_ENABLED: "true"
      GOTRUE_MAILER_AUTOCONFIRM: "true"
      GOTRUE_SMS_AUTOCONFIRM: "true"
      GOTRUE_SMTP_ADMIN_EMAIL: admin@localhost.com
      GOTRUE_SMTP_HOST: localhost
      GOTRUE_SMTP_PORT: 1025
      GOTRUE_SMTP_USER: fake_user
      GOTRUE_SMTP_PASS: fake_password

    ports:
      - "9999:9999"

  # 4. SUPABASE STUDIO
  supabase-studio:
    image: supabase/studio:latest
    container_name: supabase-studio

    depends_on:
      supabase-db:
        condition: service_healthy

      supabase-meta:
        condition: service_started

    environment:

      STUDIO_DEFAULT_ORGANIZATION: "Local Dev"
      STUDIO_DEFAULT_PROJECT: "Projeto Spring"

      POSTGRES_PASSWORD: postgres

      DATABASE_URL: postgres://postgres:postgres@supabase-db:5432/postgres

      POSTGRES_HOST: supabase-db
      POSTGRES_PORT: 5432

      STUDIO_PG_META_URL: http://supabase-meta:8080

      # URL pública do Studio
      SUPABASE_PUBLIC_URL: https://github.dev

    ports:
      - "3000:3000"

  # 5. USP API
  usp-api:
    image: ghcr.io/tetrasoft-dev/usp-api:latest
    container_name: usp-api

    depends_on:
      supabase-db:
        condition: service_healthy

    environment:

      SPRING_DATASOURCE_URL: jdbc:postgresql://supabase-db:5432/postgres
      SPRING_DATASOURCE_USERNAME: postgres
      SPRING_DATASOURCE_PASSWORD: postgres

      PUBLIC_BACKEND_URL: http://localhost:8080

    volumes:
      # Mantém os uploads disponíveis no Codespace
      - ./uploads:/app/uploads

    ports:
      - "8080:8080"

volumes:

  supabase_db_data:
    driver: local